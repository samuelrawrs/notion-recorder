#!/usr/bin/env python3
"""Optional system-tray helper for Notion Recorder.

Runs as its own small GTK3 process. The AppIndicator / StatusNotifierItem stack
is GTK3-only, so it cannot live inside the GTK4 app; keeping it separate also
means the tray survives closing the main window. From the tray you can start or
stop the Notion Meeting Mix and open the app, which is handy because the mix
keeps running after the window is closed.

Requires an AppIndicator typelib (Debian/Ubuntu package
gir1.2-ayatanaappindicator3-0.1, or the older gir1.2-appindicator3-0.1).
"""

from __future__ import annotations

import fcntl
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
try:
    gi.require_version("AyatanaAppIndicator3", "0.1")
    from gi.repository import AyatanaAppIndicator3 as AppIndicator
except (ValueError, ImportError):
    try:
        gi.require_version("AppIndicator3", "0.1")
        from gi.repository import AppIndicator3 as AppIndicator
    except (ValueError, ImportError):
        sys.stderr.write(
            "notion-recorder-tray: no AppIndicator typelib found. Install "
            "gir1.2-ayatanaappindicator3-0.1 to use the tray icon.\n"
        )
        sys.exit(1)
from gi.repository import GLib, Gtk  # noqa: E402  (after require_version)

APP_ID = "io.github.samuelrawrs.NotionRecorder"
APP_NAME = "Notion Recorder"
POLL_SECONDS = 3


def _here() -> Path:
    return Path(__file__).resolve().parent


def bridge_command() -> str:
    """Path to the notion-meeting-audio bridge (repo checkout, then PATH)."""
    sibling = _here() / "notion-meeting-audio"
    if sibling.is_file() and os.access(sibling, os.X_OK):
        return str(sibling)
    return shutil.which("notion-meeting-audio") or "notion-meeting-audio"


def app_command() -> list[str]:
    """Command that opens the main window (repo checkout, then PATH)."""
    sibling = _here() / "notion-recorder.py"
    if sibling.is_file():
        return [sys.executable, str(sibling)]
    found = shutil.which("notion-recorder")
    return [found] if found else ["notion-recorder"]


class Tray:
    def __init__(self) -> None:
        self.bridge = bridge_command()
        self.active = False

        self.indicator = AppIndicator.Indicator.new(
            APP_ID, APP_ID, AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.indicator.set_title(APP_NAME)

        menu = Gtk.Menu()
        self.status_item = Gtk.MenuItem(label="Checking\u2026")
        self.status_item.set_sensitive(False)
        menu.append(self.status_item)
        menu.append(Gtk.SeparatorMenuItem())

        self.toggle_item = Gtk.MenuItem(label="Start mix")
        self.toggle_item.connect("activate", self.on_toggle)
        menu.append(self.toggle_item)

        open_item = Gtk.MenuItem(label="Open Notion Recorder")
        open_item.connect("activate", self.on_open)
        menu.append(open_item)

        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit tray")
        quit_item.connect("activate", self.on_quit)
        menu.append(quit_item)

        menu.show_all()
        self.indicator.set_menu(menu)

        self.refresh()
        GLib.timeout_add_seconds(POLL_SECONDS, self.refresh)

    def bridge_state(self) -> bool | None:
        """True/False if the mix is on/off, None if the audio server is down."""
        try:
            result = subprocess.run(
                [self.bridge, "status"], text=True, capture_output=True, timeout=5
            )
        except (OSError, subprocess.SubprocessError):
            return None
        if result.returncode and not result.stdout:
            return None
        return ": active" in result.stdout

    def refresh(self) -> bool:
        state = self.bridge_state()
        if state is None:
            self.status_item.set_label("Audio server unavailable")
            self.toggle_item.set_sensitive(False)
            self.indicator.set_title(f"{APP_NAME} \u2013 unavailable")
            return True
        self.active = state
        self.toggle_item.set_sensitive(True)
        self.status_item.set_label(
            "Notion Meeting Mix: on" if state else "Notion Meeting Mix: off"
        )
        self.toggle_item.set_label("Stop mix" if state else "Start mix")
        self.indicator.set_title(f"{APP_NAME} \u2013 {'on' if state else 'off'}")
        return True

    def on_toggle(self, _item: Gtk.MenuItem) -> None:
        verb = "stop" if self.active else "start"
        subprocess.Popen(
            [self.bridge, verb], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        GLib.timeout_add(700, self.refresh)

    def on_open(self, _item: Gtk.MenuItem) -> None:
        subprocess.Popen(
            app_command(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )

    def on_quit(self, _item: Gtk.MenuItem) -> None:
        Gtk.main_quit()


def single_instance_lock():
    """Hold an exclusive lock so only one tray runs; return the fd to keep alive."""
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    state_dir = Path(runtime) / "notion-recorder"
    state_dir.mkdir(parents=True, exist_ok=True)
    handle = open(state_dir / "tray.lock", "w")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)  # another tray already owns it
    return handle


def main() -> None:
    _lock = single_instance_lock()  # noqa: F841 (kept alive for process lifetime)
    Tray()
    Gtk.main()


if __name__ == "__main__":
    main()
